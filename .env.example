# Copy to .env — 1 min
DATABASE_URL="postgresql://user:password@localhost:5432/questdrop"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/questdrop_test"
PORT="3000"
VOICE_DIR="./data/voice"
RUST_LOG="questdrop=debug,tower_http=debug"
# Bot (B phase): log | webhook
BOT_SINK="log"
BOT_WEBHOOK_URL=""
PUBLISHER_INTERVAL_SECS="5"
# Auth: SESSION_SECRET required in prod (without it sessions die on restart)
SESSION_SECRET="change-me-to-32-random-bytes"
# Mail: unset = log mailer (dev). Set for real mail:
SMTP_URL=""
MAIL_FROM="questdrop@localhost"
BASE_URL="http://localhost:3000"
